PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Restricted application runtime login. Express uses only this connection.
DATABASE_URL=postgresql://kristallball_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5433/military-management
# Separate migration-owner login. Maintenance scripts use only this connection.
MIGRATION_DATABASE_URL=postgresql://kristallball_migration:REPLACE_WITH_MIGRATION_PASSWORD@127.0.0.1:5433/military-management
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
APP_DATABASE_ROLE=kristallball_app
# Generate a random Base64URL secret locally; the empty placeholder intentionally fails startup.
JWT_SECRET=
